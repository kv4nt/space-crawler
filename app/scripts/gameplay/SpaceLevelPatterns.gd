class_name SpaceLevelPatterns
extends RefCounted
## Космические pixel-art паттерны для уровней: планеты, звёзды, корабли, чёрные дыры.

const SHAPES: Array[String] = [
	"rocket", "planet", "star", "black_hole", "galaxy",
	"comet", "moon", "station", "ufo", "sun",
	"asteroid", "wormhole", "nebula", "landscape", "cruiser",
	"ring_world", "satellite", "supernova", "eclipse", "meteor",
]

const THEME_NAMES: Dictionary = {
	"rocket": "Ракета",
	"planet": "Планета",
	"star": "Звезда",
	"black_hole": "Чёрная дыра",
	"galaxy": "Галактика",
	"comet": "Комета",
	"moon": "Луна",
	"station": "Станция",
	"ufo": "НЛО",
	"sun": "Солнце",
	"asteroid": "Астероид",
	"wormhole": "Червоточина",
	"nebula": "Туманность",
	"landscape": "Космопейзаж",
	"cruiser": "Крейсер",
	"ring_world": "Кольцо",
	"satellite": "Спутник",
	"supernova": "Сверхновая",
	"eclipse": "Затмение",
	"meteor": "Метеорит",
}


static func shape_for_level(global_id: int) -> String:
	return SHAPES[(global_id - 1) % SHAPES.size()]


static func theme_name(shape: String) -> String:
	return THEME_NAMES.get(shape, "Космос")


static func build(shape: String, w: int, h: int, colors: int, rng: RandomNumberGenerator) -> Array:
	match shape:
		"ring_world":
			return _make_ring(w, h, colors)
		"black_hole":
			return _fit_centered(_BLACK_HOLE, w, h, colors)
		"rocket":
			return _fit_centered(_ROCKET, w, h, colors)
		"planet":
			return _fit_centered(_PLANET, w, h, colors)
		"star":
			return _fit_centered(_STAR, w, h, colors)
		"galaxy":
			return _fit_centered(_GALAXY, w, h, colors)
		"comet":
			return _fit_centered(_COMET, w, h, colors)
		"moon":
			return _fit_centered(_MOON, w, h, colors)
		"station":
			return _fit_centered(_STATION, w, h, colors)
		"ufo":
			return _fit_centered(_UFO, w, h, colors)
		"sun":
			return _fit_centered(_SUN, w, h, colors)
		"asteroid":
			return _fit_centered(_ASTEROID, w, h, colors)
		"wormhole":
			return _fit_centered(_WORMHOLE, w, h, colors)
		"nebula":
			return _fit_centered(_NEBULA, w, h, colors)
		"landscape":
			return _fit_centered(_LANDSCAPE, w, h, colors)
		"cruiser":
			return _fit_centered(_CRUISER, w, h, colors)
		"satellite":
			return _fit_centered(_SATELLITE, w, h, colors)
		"supernova":
			return _fit_centered(_SUPERNOVA, w, h, colors)
		"eclipse":
			return _fit_centered(_ECLIPSE, w, h, colors)
		"meteor":
			return _fit_centered(_METEOR, w, h, colors)
		_:
			return _make_starfield(w, h, colors, rng)


static func _fit_centered(base: Array, w: int, h: int, colors: int) -> Array:
	var bh: int = base.size()
	var bw: int = base[0].length() if bh > 0 else 1
	var off_y := (h - bh) / 2
	var off_x := (w - bw) / 2
	var result: Array = []
	for y in range(h):
		var line := ""
		for x in range(w):
			var py := y - off_y
			var px := x - off_x
			if py >= 0 and py < bh and px >= 0 and px < bw:
				var ch: String = String(base[py])[px]
				if ch == "." or ch == " ":
					line += "."
				elif ch.is_valid_int():
					line += str(posmod(int(ch), colors))
				else:
					line += "."
			else:
				line += "."
		result.append(line)
	return result


static func _make_ring(w: int, h: int, colors: int) -> Array:
	var cx := w / 2.0
	var cy := h / 2.0
	var lines: Array = []
	for y in range(h):
		var line := ""
		for x in range(w):
			var d := Vector2(x - cx, y - cy).length()
			var outer := minf(cx, cy) * 0.88
			var inner := outer * 0.42
			if d > outer or d < inner:
				line += "."
			else:
				var band := int((d - inner) / maxf(outer - inner, 0.01) * float(colors - 1))
				line += str(clampi(band, 0, colors - 1))
		lines.append(line)
	return lines


static func _make_starfield(w: int, h: int, colors: int, rng: RandomNumberGenerator) -> Array:
	var lines: Array = []
	for y in range(h):
		var line := ""
		for x in range(w):
			if rng.randf() < 0.12:
				line += str(rng.randi_range(0, maxi(colors - 1, 0)))
			else:
				line += "."
		lines.append(line)
	return lines


